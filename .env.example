# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke GitHub!

# Database
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/fintrack

# JWT Secret Key - ganti dengan string acak yang panjang
JWT_SECRET_KEY=ganti-dengan-secret-key-yang-panjang-dan-acak

# Environment
FLASK_ENV=development
FLASK_APP=wsgi.py
PORT=5000
